#!/usr/bin/env python3
"""Git pre-commit hook (docs/STUDIO.md). scripts/new_post.py, preview.py and publish.py turn it on with
`git config core.hooksPath scripts/git-hooks`. Skip it once with `git commit --no-verify`.

Always: refuses a staged .md file under content/ that isn't valid UTF-8 (TextEdit and some Windows
editors save UTF-16), since nothing can tell whether it's a draft.

Drafts are fine to commit: the studio repo is private, and GitHub builds the public site without them.
Only while `origin` is still the public repo (before scripts/setup_studio.sh has run) does it also
refuse drafts, as it did when this was the public repo: any staged file whose text is (or might be) a
draft (see app/content.py), and any file in a paper's folder whose staged paper.md is a draft or missing.
"""
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
VENV = ROOT / ".venv"
if (VENV / "bin" / "python").exists() and Path(sys.prefix).resolve() != VENV.resolve():
    os.execv(VENV / "bin" / "python", [str(VENV / "bin" / "python"), __file__, *sys.argv[1:]])
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "scripts"))
from app import content, papers  # noqa: E402
import repos  # noqa: E402


def git(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], check=True, capture_output=True).stdout


def staged_paper_is_draft(folder, cache={}):
    """A paper's files may be committed (to the public repo) only with a staged paper.md that isn't a draft."""
    if folder not in cache:
        shown = subprocess.run(["git", "-C", str(ROOT), "show", f":{folder}/paper.md"], capture_output=True)
        cache[folder] = shown.returncode != 0 or papers.is_draft_text(content.loose_text(shown.stdout),
                                                                      f"{folder}/paper.md")
    return cache[folder]


guard_drafts = repos.origin_is_public(ROOT)
staged = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR", "--", "content").decode().split("\0")
drafts, not_utf8 = [], []
for name in staged:
    if not name or name == "content/POST_TEMPLATE.md" or name.startswith("content/PAPER_TEMPLATE/"):
        continue
    parts = name.split("/")
    in_paper = len(parts) > 3 and parts[1] == "papers"  # content/papers/<slug>/<file>
    if in_paper and guard_drafts:
        if staged_paper_is_draft("/".join(parts[:3])):
            drafts.append(name)
        continue
    if not name.endswith(".md") and not guard_drafts:
        continue  # images, .tex, .bib: nothing to check once drafts may be committed
    raw = git("show", f":{name}")
    try:
        text = raw.decode("utf-8")
        if "\0" in text:  # UTF-16 without a byte-order mark
            raise UnicodeDecodeError("utf-8", raw, 0, 1, "NUL byte")
    except UnicodeDecodeError:  # fail closed: a post or tool we can't read might be a draft
        if name.endswith(".md"):
            not_utf8.append(name)
            continue
        text = content.loose_text(raw)
    if guard_drafts and not in_paper and content.is_draft(text, name):
        drafts.append(name)
if not_utf8:
    print("Not committed: these aren't plain UTF-8 text, so they can't be checked for drafts.\n  "
          + "\n  ".join(not_utf8) + "\nSave them as UTF-8 (in TextEdit: Format > Make Plain Text, then save"
          + " with encoding Unicode (UTF-8)) and stage them again.", file=sys.stderr)
if drafts:
    print(f"Not committed: these are drafts, and origin is still the public repo ({repos.PUBLIC}).\n  "
          + "\n  ".join(drafts) + "\nUnstage them with: git restore --staged <file>"
          + "\nDrafts can be committed once scripts/setup_studio.sh has moved origin to the private studio"
          + " repo (docs/STUDIO.md).", file=sys.stderr)
if drafts or not_utf8:
    sys.exit(1)
